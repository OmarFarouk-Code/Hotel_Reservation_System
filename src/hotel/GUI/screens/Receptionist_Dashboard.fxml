<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="780.0" prefWidth="1280.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hotel.GUI.controllers.Receptionist_Dashboard">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  LEFT SIDEBAR (shared component)                        -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <fx:include fx:id="sideBar" source="side-bar.fxml" />

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  MAIN CONTENT AREA                                      -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f5f2eb;">

        <!-- TOP BAR (shared component) -->
        <fx:include fx:id="topBar" source="top-bar.fxml" />

        <!-- SCROLLABLE BODY -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="24.0" style="-fx-background-color: #f5f2eb;">
                <padding>
                    <Insets bottom="32.0" left="32.0" right="32.0" top="28.0" />
                </padding>

                <!-- ─── GREETING ROW ─────────────────────────────── -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblGreeting"
                               text="Good morning."
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a3228; -fx-font-family: 'Georgia';" />
                        <Label fx:id="lblDateSubtitle"
                               text="Here is the overview for today."
                               style="-fx-font-size: 13px; -fx-text-fill: #777;" />
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" spacing="2.0">
                        <Label text="CURRENT LOCAL TIME"
                               style="-fx-font-size: 10px; -fx-text-fill: #999; -fx-letter-spacing: 1;" />
                        <Label fx:id="lblCurrentTime" text="--:-- --"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a3228;" />
                    </VBox>
                </HBox>

                <!-- ─── RECEPTIONIST PROFILE BADGE ───────────────── -->
                <HBox spacing="16.0" alignment="CENTER_LEFT"
                      style="-fx-background-color: #1a3228; -fx-background-radius: 12; -fx-padding: 16 24 16 24;">
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblProfileUsername"
                               text="Username: —"
                               style="-fx-font-size: 13px; -fx-text-fill: #8fbbaa;" />
                        <Label fx:id="lblProfileRole"
                               text="Role: Receptionist"
                               style="-fx-font-size: 12px; -fx-text-fill: #8fbbaa;" />
                        <Label fx:id="lblProfileStatus"
                               text="Status: —"
                               style="-fx-font-size: 12px; -fx-text-fill: #8fbbaa;" />
                        <Label fx:id="lblProfileWorkHours"
                               text="Working Hours: —"
                               style="-fx-font-size: 12px; -fx-text-fill: #8fbbaa;" />
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" spacing="4.0">
                        <Label fx:id="lblPendingBadge" text="7 Pending"
                               style="-fx-font-size: 12px; -fx-text-fill: #e67e22; -fx-font-weight: bold;" />
                        <Button fx:id="btnLogout" text="⏻  Logout"
                                onAction="#onLogout"
                                style="-fx-background-color: #c0392b; -fx-text-fill: white;
                                       -fx-font-size: 12px; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 14 6 14;" />
                    </VBox>
                </HBox>

                <!-- ─── KPI STAT CARDS ROW ────────────────────────── -->
                <HBox spacing="16.0">

                    <!-- Check-Ins -->
                    <VBox fx:id="cardCheckIns"
                          style="-fx-background-color: white; -fx-background-radius: 12;
                                 -fx-padding: 20 24 20 24;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          prefWidth="195" spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="CHECK-INS TODAY"
                               style="-fx-font-size: 10px; -fx-text-fill: #999; -fx-letter-spacing: 1;" />
                        <HBox alignment="BASELINE_LEFT" spacing="8.0">
                            <Label fx:id="lblCheckInCount" text="0"
                                   style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #1a3228;" />
                            <Label text="Expected"
                                   style="-fx-font-size: 13px; -fx-text-fill: #999;" />
                        </HBox>
                        <Label fx:id="lblCheckInDone" text="0 completed"
                               style="-fx-font-size: 11px; -fx-text-fill: #2e8b57;" />
                    </VBox>

                    <!-- Check-Outs -->
                    <VBox fx:id="cardCheckOuts"
                          style="-fx-background-color: white; -fx-background-radius: 12;
                                 -fx-padding: 20 24 20 24;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          prefWidth="195" spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="CHECK-OUTS TODAY"
                               style="-fx-font-size: 10px; -fx-text-fill: #999; -fx-letter-spacing: 1;" />
                        <HBox alignment="BASELINE_LEFT" spacing="8.0">
                            <Label fx:id="lblCheckOutCount" text="0"
                                   style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #1a3228;" />
                            <Label text="Pending"
                                   style="-fx-font-size: 13px; -fx-text-fill: #999;" />
                        </HBox>
                        <Label fx:id="lblCheckOutDone" text="0 completed"
                               style="-fx-font-size: 11px; -fx-text-fill: #2e8b57;" />
                    </VBox>

                    <!-- Pending Requests -->
                    <VBox fx:id="cardPendingRequests"
                          style="-fx-background-color: white; -fx-background-radius: 12;
                                 -fx-padding: 20 24 20 24;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);
                                 -fx-border-color: #e67e22; -fx-border-width: 0 0 3 0; -fx-border-radius: 12;"
                          prefWidth="220" spacing="6.0" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Label text="⚠" style="-fx-font-size: 12px; -fx-text-fill: #e67e22;" />
                            <Label text="PENDING RESERVATIONS"
                                   style="-fx-font-size: 10px; -fx-text-fill: #999; -fx-letter-spacing: 1;" />
                        </HBox>
                        <HBox alignment="BASELINE_LEFT" spacing="8.0">
                            <Label fx:id="lblPendingCount" text="0"
                                   style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #1a3228;" />
                            <Label text="Needs Attention"
                                   style="-fx-font-size: 13px; -fx-text-fill: #e67e22;" />
                        </HBox>
                    </VBox>

                    <!-- Occupancy -->
                    <VBox fx:id="cardOccupancy"
                          style="-fx-background-color: #1a3228; -fx-background-radius: 12;
                                 -fx-padding: 20 24 20 24;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.14), 10, 0, 0, 3);"
                          HBox.hgrow="ALWAYS" spacing="6.0">
                        <Label text="OCCUPANCY"
                               style="-fx-font-size: 10px; -fx-text-fill: #8fbbaa; -fx-letter-spacing: 1;" />
                        <HBox alignment="BASELINE_LEFT" spacing="8.0">
                            <Label fx:id="lblOccupancyPercent" text="0%"
                                   style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: white;" />
                            <Label text="Tonight"
                                   style="-fx-font-size: 13px; -fx-text-fill: #8fbbaa;" />
                        </HBox>
                        <Label fx:id="lblOccupancyRooms" text="0 / 0 rooms"
                               style="-fx-font-size: 11px; -fx-text-fill: #8fbbaa;" />
                    </VBox>

                    <!-- Available Rooms -->
                    <VBox fx:id="cardAvailableRooms"
                          style="-fx-background-color: white; -fx-background-radius: 12;
                                 -fx-padding: 20 24 20 24;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          prefWidth="175" spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="AVAILABLE"
                               style="-fx-font-size: 10px; -fx-text-fill: #999; -fx-letter-spacing: 1;" />
                        <HBox alignment="BASELINE_LEFT" spacing="8.0">
                            <Label fx:id="lblAvailableRooms" text="0"
                                   style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #2e8b57;" />
                            <Label text="Rooms"
                                   style="-fx-font-size: 13px; -fx-text-fill: #999;" />
                        </HBox>
                        <Label text="Ready for booking"
                               style="-fx-font-size: 11px; -fx-text-fill: #888;" />
                    </VBox>

                </HBox>

                <!-- ─── SEARCH BAR ────────────────────────────────── -->
                <HBox alignment="CENTER_LEFT" spacing="12.0"
                      style="-fx-background-color: white; -fx-background-radius: 8;
                             -fx-padding: 10 16 10 16;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                    <Label text="🔍" style="-fx-font-size: 14px; -fx-text-fill: #999;" />
                    <TextField fx:id="searchField"
                               promptText="Search guests, reservation IDs, room numbers…"
                               HBox.hgrow="ALWAYS"
                               onKeyReleased="#onSearch"
                               style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 13px;" />
                </HBox>

                <!-- SEARCH RESULTS PANEL (hidden by default) -->
                <VBox fx:id="searchResultsPanel" spacing="8.0" managed="false" visible="false"
                      style="-fx-background-color: white; -fx-background-radius: 10;
                             -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <Label text="Search Results"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a3228;" />
                    <Label fx:id="lblSearchResults" text=""
                           style="-fx-font-size: 13px; -fx-text-fill: #555;" wrapText="true" />
                </VBox>

                <!-- ─── CHECK-INS & CHECK-OUTS TABLES ────────────── -->
                <HBox spacing="24.0" alignment="TOP_LEFT">

                    <!-- ── CHECK-INS TODAY ─── -->
                    <VBox HBox.hgrow="ALWAYS" spacing="12.0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Check-ins Today"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a3228;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Hyperlink text="View All" onAction="#onViewAllCheckIns"
                                       style="-fx-font-size: 12px; -fx-text-fill: #2e8b57; -fx-border-color: transparent;" />
                        </HBox>
                        <!-- Dynamic list of check-in rows -->
                        <VBox fx:id="checkInsContainer" spacing="8.0" />
                        <Label fx:id="lblNoCheckIns" text="No check-ins today."
                               style="-fx-font-size: 12px; -fx-text-fill: #aaa; -fx-font-style: italic;"
                               managed="false" visible="false" />
                    </VBox>

                    <!-- ── CHECK-OUTS TODAY ─── -->
                    <VBox prefWidth="380.0" spacing="12.0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Check-outs Today"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a3228;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Hyperlink text="View All" onAction="#onViewAllCheckOuts"
                                       style="-fx-font-size: 12px; -fx-text-fill: #2e8b57; -fx-border-color: transparent;" />
                        </HBox>
                        <!-- Dynamic list of check-out rows -->
                        <VBox fx:id="checkOutsContainer" spacing="8.0" />
                        <Label fx:id="lblNoCheckOuts" text="No check-outs today."
                               style="-fx-font-size: 12px; -fx-text-fill: #aaa; -fx-font-style: italic;"
                               managed="false" visible="false" />
                    </VBox>

                </HBox>

                <!-- ─── PENDING RESERVATIONS TABLE ───────────────── -->
                <VBox spacing="12.0">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Pending Reservations — Awaiting Action"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a3228;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Resolve All" onAction="#onResolveAllPending"
                                style="-fx-background-color: transparent; -fx-text-fill: #e67e22;
                                       -fx-font-size: 11px; -fx-cursor: hand; -fx-border-color: #e67e22;
                                       -fx-border-radius: 4; -fx-padding: 4 10 4 10;" />
                    </HBox>
                    <VBox fx:id="pendingContainer" spacing="8.0"
                          style="-fx-background-color: white; -fx-background-radius: 10;
                                 -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                        <Label fx:id="lblNoPending" text="No pending reservations."
                               style="-fx-font-size: 12px; -fx-text-fill: #aaa; -fx-font-style: italic;" />
                    </VBox>
                </VBox>

                <!-- ─── CHECK-IN DIALOG (hidden) ─────────────────── -->
                <VBox fx:id="checkInDialog" managed="false" visible="false" spacing="12.0"
                      style="-fx-background-color: white; -fx-background-radius: 12;
                             -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 4);
                             -fx-border-color: #1a3228; -fx-border-width: 2; -fx-border-radius: 12;">
                    <Label fx:id="lblDialogTitle" text="Confirm Check-In"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a3228;" />
                    <Label fx:id="lblDialogInfo" text=""
                           style="-fx-font-size: 13px; -fx-text-fill: #555;" wrapText="true" />
                    <HBox spacing="12.0">
                        <Button fx:id="btnDialogConfirm" text="✔  Confirm Check-In"
                                onAction="#onDialogConfirm"
                                style="-fx-background-color: #1a3228; -fx-text-fill: white;
                                       -fx-font-size: 13px; -fx-background-radius: 7; -fx-cursor: hand; -fx-padding: 8 18 8 18;" />
                        <Button text="✕  Cancel"
                                onAction="#onDialogCancel"
                                style="-fx-background-color: transparent; -fx-text-fill: #888;
                                       -fx-font-size: 13px; -fx-border-color: #ccc; -fx-border-radius: 7;
                                       -fx-cursor: hand; -fx-padding: 8 18 8 18;" />
                    </HBox>
                </VBox>

                <!-- ─── CHECK-OUT DIALOG (hidden) ────────────────── -->
                <VBox fx:id="checkOutDialog" managed="false" visible="false" spacing="12.0"
                      style="-fx-background-color: white; -fx-background-radius: 12;
                             -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 4);
                             -fx-border-color: #c0392b; -fx-border-width: 2; -fx-border-radius: 12;">
                    <Label fx:id="lblCheckOutDialogTitle" text="Confirm Check-Out"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a3228;" />
                    <Label fx:id="lblCheckOutDialogInfo" text=""
                           style="-fx-font-size: 13px; -fx-text-fill: #555;" wrapText="true" />
                    <HBox spacing="12.0">
                        <Button fx:id="btnCheckOutConfirm" text="✔  Confirm Check-Out"
                                onAction="#onCheckOutConfirm"
                                style="-fx-background-color: #c0392b; -fx-text-fill: white;
                                       -fx-font-size: 13px; -fx-background-radius: 7; -fx-cursor: hand; -fx-padding: 8 18 8 18;" />
                        <Button text="✕  Cancel"
                                onAction="#onCheckOutDialogCancel"
                                style="-fx-background-color: transparent; -fx-text-fill: #888;
                                       -fx-font-size: 13px; -fx-border-color: #ccc; -fx-border-radius: 7;
                                       -fx-cursor: hand; -fx-padding: 8 18 8 18;" />
                    </HBox>
                </VBox>

                <!-- ─── FEEDBACK LABEL ────────────────────────────── -->
                <Label fx:id="lblFeedback" text="" wrapText="true"
                       style="-fx-font-size: 13px; -fx-text-fill: #2e8b57;"
                       managed="false" visible="false" />

                <!-- ─── RECENT ACTIVITY LOG ───────────────────────── -->
                <VBox spacing="12.0">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Recent Activity"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a3228;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Clear Log" onAction="#onClearLog"
                                style="-fx-background-color: transparent; -fx-text-fill: #888;
                                       -fx-font-size: 11px; -fx-cursor: hand;" />
                    </HBox>
                    <VBox fx:id="activityLog" spacing="6.0"
                          style="-fx-background-color: white; -fx-background-radius: 10;
                                 -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                        <Label text="No activity yet today."
                               style="-fx-font-size: 12px; -fx-text-fill: #aaa; -fx-font-style: italic;" />
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
