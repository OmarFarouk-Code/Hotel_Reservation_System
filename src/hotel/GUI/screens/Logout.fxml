      <HBox alignment="CENTER_LEFT" layoutY="320.0" prefHeight="45.0" style="-fx-background-color: #f5f4ef; -fx-background-radius: 0 0 8 8;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
