<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="380.0" prefWidth="380.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #0b3b24 transparent transparent transparent; -fx-border-width: 4 0 0 0; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hotel.GUI.controllers.LogoutController">
   <children>
      <VBox alignment="CENTER" layoutX="30.0" layoutY="30.0" spacing="18.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
         <children>
            <StackPane prefHeight="60.0" prefWidth="60.0">
               <children>
                  <Circle fill="#f5f4ef" radius="30.0" stroke="TRANSPARENT" strokeType="INSIDE" />
                  <SVGPath content="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" fill="#0b3b24" scaleX="1.2" scaleY="1.2" />
               </children>
            </StackPane>
            
            <Label text="Log Out?" textFill="#0b3b24">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            
            <Label alignment="CENTER" prefWidth="320.0" text="Are you sure you want to end your session? Any unsaved changes may be lost. You will need to re-authenticate to access the concierge dashboard." textAlignment="CENTER" textFill="#666666" wrapText="true">
               <font>
                  <Font size="13.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Label>
            
            <HBox alignment="CENTER" spacing="8.0">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </HBox>
            
            <HBox alignment="CENTER" spacing="15.0">
               <children>
                  <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" prefHeight="45.0" prefWidth="150.0" style="-fx-background-color: transparent; -fx-border-color: #e8e8e8; -fx-border-radius: 8; -fx-text-fill: #4c688c; -fx-font-weight: bold; -fx-cursor: hand;" text="CANCEL">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Button>
                  <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#handleLogout" prefHeight="45.0" prefWidth="150.0" style="-fx-background-color: #0b3b24; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" text="LOG OUT">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Button>
